index 0000000000..22e8e53402
--- /dev/null
+++ b/packages/client/ui-primitives/src/StatisticPill.tsx
@@ -0,0 +1,62 @@
+/** Locale-free statistic readings and their viewport-anchored details. */
+import { useEffect, useRef, useState, type HTMLAttributes, type ReactNode } from 'react'
+import { createPortal } from 'react-dom'
+import clsx from 'clsx'
+import { useAnchoredPosition } from './useAnchoredPosition.ts'
+import { useDismissOnOutsidePointer } from './useDismissOnOutsidePointer.ts'
+import css from './StatisticPill.module.css'
+
+/** The owner supplies labels, values and detail content; no business store is read. */
+export interface StatisticPillProps {
+  readonly stat?: string
+  readonly icon: ReactNode
+  readonly label: ReactNode
+  readonly ariaLabel?: string
+  readonly appearance?: 'dock' | 'inline'
+  readonly details?: { readonly title: string; readonly titleValue?: string; readonly content: ReactNode } | undefined
+}
+
+/**
+ * A static reading or a button opening a shared statistic details surface.
+ * @param props - localized display content.
+ * @returns the reading and its optional portaled dialog.
+ */
+export function StatisticPill({ stat, icon, label, ariaLabel, appearance = 'dock', details }: StatisticPillProps): ReactNode {
+  const [open, setOpen] = useState(false)
+  const rootRef = useRef<HTMLSpanElement | null>(null)
+  const panelRef = useRef<HTMLDivElement | null>(null)
+  const pos = useAnchoredPosition({ open, anchorRef: rootRef, panelRef, side: 'top', gap: 8, margin: 12 })
+  useDismissOnOutsidePointer(rootRef, open, setOpen, panelRef)
+  useEffect(() => {
+    if (!open) return
+    const key = (event: KeyboardEvent): void => { if (event.key === 'Escape') setOpen(false) }
+    const click = (event: MouseEvent): void => {
+      if (event.target instanceof Node
+        && !rootRef.current?.contains(event.target)
+        && !panelRef.current?.contains(event.target)) setOpen(false)
+    }
+    document.addEventListener('keydown', key)
+    document.addEventListener('click', click, true)
+    return () => { document.removeEventListener('keydown', key); document.removeEventListener('click', click, true) }
+  }, [open])
+  const content = <>{icon}<span className={css.label}>{label}</span></>
+  return <span ref={rootRef} className={clsx(css.anchor, appearance === 'inline' && css.inline)} data-composer-stat={stat}>
+    {details === undefined ? <span className={css.pill}>{content}</span> : <button type="button" className={css.pill}
+      aria-label={ariaLabel} aria-haspopup="dialog" aria-expanded={open} onClick={() => { setOpen(!open) }}>{content}</button>}
+    {open && details !== undefined && createPortal(<div ref={panelRef} className={css.panel} role="dialog"
+      aria-label={details.title} style={pos ?? { visibility: 'hidden', left: 0, top: 0 }}>
+      <div className={css.title}><span className={css.titleLabel}>{icon}{details.title}</span>
+        {details.titleValue !== undefined && <span className={css.titleValue}>{details.titleValue}</span>}</div>
+      <div className={css.titleRule} aria-hidden />{details.content}
+    </div>, document.body)}
+  </span>
+}
+
+/**
+ * Shared definition-list skin. Owners retain their localized rows and semantic attributes.
+ * @param props - definition-list contents and attributes.
+ * @returns a styled definition list.
+ */
+export function StatisticDetails({ className, ...props }: HTMLAttributes<HTMLDListElement>): ReactNode {
+  return <dl {...props} className={clsx(css.details, className)} />
+}
